{
  "name": "wren",
  "version": "0.1.1",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "description": "Interactive coding agent with @opentui/solid TUI, supporting any OpenAI-compatible or Anthropic provider.",
  "files": [
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "apps/cli/package.json",
    "apps/cli/src/",
    "apps/cli/compile.ts",
    "apps/cli/build.ts",
    "apps/web/package.json",
    "apps/web/src/",
    "apps/web/build.ts",
    "apps/web/index.html",
    ".wren-config.example.json",
    "packages/adapter/package.json",
    "packages/adapter/src/**",
    "packages/engine/package.json",
    "packages/engine/src/**",
    "packages/model-provider/package.json",
    "packages/model-provider/src/**",
    "packages/protocol/package.json",
    "packages/protocol/src/**",
    "packages/config-node/package.json",
    "packages/config-node/src/**",
    "packages/client/package.json",
    "packages/client/src/**",
    "packages/application/package.json",
    "packages/application/src/**",
    "packages/storage/package.json",
    "packages/storage/src/**",
    "packages/tui/package.json",
    "packages/tui/src/**",
    "packages/image-processor-napi/package.json",
    "packages/image-processor-napi/src/**",
    "config/follow-redirects-shim.ts",
    "scripts/build-release.ts",
    "bunfig.toml"
  ],
  "bin": {
    "wren": "apps/cli/src/main.ts"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "version:sync": "bun run scripts/sync-version.ts",
    "build": "bun run --filter '*' build",
    "build:binary": "bun run apps/cli/compile.ts",
    "build:release": "bun run scripts/build-release.ts",
    "check": "biome check .",
    "format": "biome format --write .",
    "lint": "biome check .",
    "test": "bun test --isolate tests/ apps/cli/src packages/adapter/src packages/storage/src packages/tui/ packages/protocol/src packages/config-node/src packages/client/src packages/application/src apps/web/src",
    "test:engine:wren": "bun test --isolate packages/engine/src/capability-manifest.test.ts packages/engine/src/history-snapshot.test.ts packages/engine/src/utils/model/__tests__/configBridge.test.ts packages/engine/src/__tests__/query-yield.test.ts packages/engine/src/services/api/gemini/__tests__/queryModelGemini.test.ts packages/engine/src/storage/transcript-mirror.test.ts",
    "test:engine:vendor-diagnostic": "bun test --isolate packages/engine/src/",
    "test:e2e": "bun test --isolate apps/cli/cli-pty.test.ts",
    "test:live": "bun test --isolate apps/cli/cli-pty.test.ts apps/cli/final-e2e.test.ts",
    "test:pty": "bun test --isolate apps/cli/interactive-pty.test.ts",
    "test:package": "bun test --isolate apps/cli/installed-package.test.ts",
    "typecheck": "tsc --build --pretty false",
    "quality:typecheck:green": "tsc -p packages/protocol/tsconfig.json --noEmit && tsc -p packages/config-node/tsconfig.json --noEmit && tsc -p packages/client/tsconfig.json --noEmit && tsc -p packages/application/tsconfig.json --noEmit && tsc -p packages/storage/tsconfig.json --noEmit && tsc -p packages/model-provider/tsconfig.json --noEmit",
    "quality:typecheck:triage": "tsc -p packages/adapter/tsconfig.json --noEmit && tsc -p apps/cli/tsconfig.json --noEmit && tsc -p packages/tui/tsconfig.json --noEmit && tsc -b packages/protocol/tsconfig.json --pretty false && tsc -p apps/web/tsconfig.json --noEmit --pretty false",
    "quality:typecheck:vendor-report": "tsc -p packages/engine/tsconfig.json --noEmit --pretty false 2>&1 | wc -l || true",
    "quality:ci": "biome check biome.json package.json && bun run quality:typecheck:green && bun run quality:typecheck:triage && bun test --isolate packages/adapter/src packages/storage/src packages/tui/ apps/cli/src packages/protocol/src packages/config-node/src packages/client/src packages/application/src && bun run test:engine:wren && bun test --isolate tests/release-artifact.test.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.19.0",
    "@anthropic-ai/sdk": "^0.81.0",
    "@commander-js/extra-typings": "^14.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentui/core": "0.5.1",
    "@opentui/solid": "0.5.1",
    "ajv": "^8.17.1",
    "axios": "^1.19.0",
    "chalk": "^5.6.2",
    "chokidar": "^4.0.3",
    "diff": "^7.0.0",
    "env-paths": "^3.0.0",
    "execa": "^9.6.1",
    "figlet": "^1.11.4",
    "figures": "^6.1.0",
    "fuse.js": "^7.5.0",
    "he": "^1.2.0",
    "highlight.js": "^11.11.1",
    "https-proxy-agent": "^7.0.6",
    "ignore": "^7.0.6",
    "jsonc-parser": "^3.3.1",
    "lodash-es": "^4.0.0",
    "lru-cache": "^11.0.0",
    "marked": "^17.0.6",
    "openai": "^6.49.0",
    "p-map": "^7.0.6",
    "picomatch": "^4.0.2",
    "proper-lockfile": "^4.1.2",
    "semver": "^7.7.4",
    "sharp": "^0.35.3",
    "shell-quote": "^1.10.0",
    "signal-exit": "^4.1.0",
    "solid-js": "1.9.14",
    "strip-ansi": "^7.2.0",
    "tree-kill": "^1.2.2",
    "turndown": "^7.2.4",
    "undici": "^7.29.0",
    "usehooks-ts": "^3.1.1",
    "vscode-jsonrpc": "^8.2.1",
    "vscode-languageserver-protocol": "^3.17.5",
    "vscode-languageserver-types": "^3.17.5",
    "ws": "^8.21.2",
    "xss": "^1.0.15",
    "yaml": "^2.8.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@babel/core": "7.28.0",
    "@babel/preset-typescript": "7.27.1",
    "@biomejs/biome": "2.4.12",
    "@types/bun": "1.3.14",
    "@types/diff": "^7.0.0",
    "@types/he": "^1.2.3",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.10.0",
    "@types/picomatch": "^4.0.3",
    "@types/proper-lockfile": "^4.1.4",
    "@types/semver": "^7.8.0",
    "@types/shell-quote": "^1.7.5",
    "@types/ws": "^8.18.1",
    "babel-plugin-module-resolver": "5.0.3",
    "babel-preset-solid": "1.9.12",
    "esbuild": "^0.28.2",
    "typescript": "5.8.2"
  },
  "trustedDependencies": [
    "esbuild"
  ],
  "optionalDependencies": {
    "@opentui/core-linux-x64": "0.5.1",
    "@opentui/core-linux-x64-musl": "0.5.1"
  },
  "patchedDependencies": {
    "@opentui/solid@0.5.1": "patches/@opentui%2Fsolid@0.5.1.patch",
    "@opentui/core@0.5.1": "patches/@opentui%2Fcore@0.5.1.patch"
  }
}
