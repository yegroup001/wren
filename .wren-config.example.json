{
  "defaultModel": {
    "source": "zhipu",
    "model": "glm-5.2"
  },
  "agentModels": {
    "general-purpose": { "source": "zhipu", "model": "glm-5.2" },
    "explore": { "source": "zhipu", "model": "glm-5.2-fast" },
    "verification": { "source": "zhipu", "model": "glm-5.2", "effort": "high" }
  },
  "taskModels": {
    "memory": { "source": "zhipu", "model": "glm-5.2" },
    "classifier": { "source": "zhipu", "model": "glm-5.2-fast" },
    "compact": { "source": "zhipu", "model": "glm-5.2-fast" },
    "title": { "source": "zhipu", "model": "glm-5.2-fast" },
    "websearch": { "source": "zhipu", "model": "glm-5.2-fast" },
    "permission-explainer": { "source": "zhipu", "model": "glm-5.2-fast" },
    "attachment-summary": { "source": "zhipu", "model": "glm-5.2-fast" },
    "hook": { "source": "zhipu", "model": "glm-5.2-fast" }
  },
  "sources": {
    "zhipu": {
      "type": "openai-compatible-chat",
      "baseUrl": "https://open.bigmodel.cn/api/paas/v4",
      "apiKey": "$ZHIPU_API_KEY",
      "models": {
        "glm-5.2": {
          "contextWindow": 1048576,
          "displayName": "GLM 5.2",
          "supportsThinking": true,
          "efforts": ["low", "medium", "high", "xhigh", "max"]
        },
        "glm-5.2-fast": {
          "contextWindow": 128000,
          "displayName": "GLM 5.2 Fast",
          "supportsThinking": false
        }
      }
    }
  },
  "theme": "dark",
  "autoCompact": true,
  "preferredLanguage": "auto"
}
