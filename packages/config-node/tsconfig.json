{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src",
    "paths": {
      "@wren/protocol": ["../protocol/src/index.ts"],
      "@wren/protocol/*": ["../protocol/src/*"]
